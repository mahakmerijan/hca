# ══════════════════════════════════════════════════════════════════
# Human Communication Agent — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════

# ── GCP Service Account (replaces gcp_service*.json file) ────────
# Copy each field directly from your service account JSON file.
# On Render: add each as a separate environment variable.
GCP_TYPE=service_account
GCP_PROJECT_ID=your-gcp-project-id
GCP_PRIVATE_KEY_ID=your-private-key-id
GCP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n
GCP_CLIENT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
GCP_CLIENT_ID=your-client-id
GCP_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GCP_TOKEN_URI=https://oauth2.googleapis.com/token
GCP_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GCP_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your-sa%40your-project.iam.gserviceaccount.com
GCP_UNIVERSE_DOMAIN=googleapis.com

# ── Vertex AI ─────────────────────────────────────────────────────
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1
LLM_MODEL=gemini-2.5-pro

# ── LangSmith tracing (optional but recommended) ─────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=hca-digital-twin

# ── Pinecone vector store ─────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX=hca-twin-memory
# PINECONE_ENVIRONMENT=us-east-1-aws  # only needed for older SDK

# ── Weaviate vector store ─────────────────────────────────────────
WEAVIATE_URL=https://your-cluster.weaviate.network
WEAVIATE_API_KEY=your-weaviate-api-key-here

# ── Redis cache ───────────────────────────────────────────────────
# Leave empty to use in-memory fallback (dev mode)
REDIS_URL=redis://localhost:6379/0

# ── PostgreSQL (production memory + user DB) ─────────────────────
# Leave empty to use in-memory fallbacks (dev mode)
POSTGRES_URI=postgresql://user:password@localhost:5432/hca_db

# ── JWT Auth ──────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production

# ── Flask ─────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_PORT=5002
